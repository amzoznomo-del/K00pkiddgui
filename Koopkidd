local function applyDecalOnce(imageId)
	local tex = "rbxassetid://" .. tostring(imageId)
	local faces = {
		Enum.NormalId.Front, Enum.NormalId.Back,
		Enum.NormalId.Left, Enum.NormalId.Right,
		Enum.NormalId.Top, Enum.NormalId.Bottom
	}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			pcall(function()
				for _, child in ipairs(obj:GetChildren()) do
					if child:IsA("Decal") or child:IsA("Texture") then
						child:Destroy()
					end
				end
				for _, face in ipairs(faces) do
					local d = Instance.new("Decal")
					d.Texture = tex
					d.Face = face
					d.Parent = obj
				end
			end)
		end
	end
end

local function applySkybox(imageId)
	local tex = "rbxassetid://" .. tostring(imageId)
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("Sky") then v:Destroy() end
	end
	local sky = Instance.new("Sky")
	sky.Name = "CustomSky"
	sky.SkyboxBk = tex
	sky.SkyboxDn = tex
	sky.SkyboxFt = tex
	sky.SkyboxLf = tex
	sky.SkyboxRt = tex
	sky.SkyboxUp = tex
	sky.Parent = Lighting
end

local function applyParticle(imageId)
	local tex = "rbxassetid://" .. tostring(imageId)
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			pcall(function()
				local pe = Instance.new("ParticleEmitter")
				pe.Texture = tex
				pe.Rate = 20
				pe.Speed = NumberRange.new(5, 10)
				pe.Size = NumberSequence.new(2)
				pe.Lifetime = NumberRange.new(1, 3)
				pe.Parent = obj
			end)
		end
	end
end

local function playMusicWithReverb(soundId, looped, pitch)
	local music = Instance.new("Sound")
	music.Name = "MapBackgroundMusic"
	music.SoundId = "rbxassetid://" .. tostring(soundId)
	music.PlaybackSpeed = pitch or 0.9
	music.Volume = 999999
	music.Looped = looped
	music.Parent = Workspace

	local reverb = Instance.new("ReverbSoundEffect")
	reverb.Name = "MusicReverb"
	reverb.DecayTime = 3.5
	reverb.Density = 1
	reverb.Diffusion = 1
	reverb.DryLevel = 0
	reverb.WetLevel = 6
	reverb.Parent = music

	music:Play()
	return music
end

local function showMessage(text, duration)
	local m = Instance.new("Message", Workspace)
	m.Text = text
	task.wait(duration or 5)
	if m then m:Destroy() end
end

local function showHint(text, duration)
	local h = Instance.new("Hint", Workspace)
	h.Text = text
	task.wait(duration or 9999999999)
	if h then h:Destroy() end
end

local function applyDisco()
	local CYCLE_TIME = 22
	local START_HUE = 0.08
	local SATURATION = 1
	local DARKEN = -0.05

	local cc = Lighting:FindFirstChild("WorldHueCC") or Instance.new("ColorCorrectionEffect")
	cc.Name = "WorldHueCC"
	cc.Brightness = DARKEN
	cc.Contrast = 0.05
	cc.Parent = Lighting

	if not _G.DiscoConnected then
		_G.DiscoConnected = true
		RunService.RenderStepped:Connect(function()
			local hue = (START_HUE + os.clock() / CYCLE_TIME) % 1
			local color = Color3.fromHSV(hue, SATURATION, 1)
			cc.TintColor = color
			Lighting.ColorShift_Top = color
		end)
	end
end

local function applySingleJumpscare(imageId, duration, soundId)
	local jumpSound = Instance.new("Sound")
	jumpSound.Name = "JumpscareSound"
	jumpSound.SoundId = "rbxassetid://" .. tostring(soundId or DEFAULT_JUMPSCARE_SOUND_ID)
	jumpSound.Volume = 9999999
	jumpSound.Parent = SoundService

	local soundReverb = Instance.new("ReverbSoundEffect")
	soundReverb.DecayTime = 6.0
	soundReverb.Density = 1.0
	soundReverb.Diffusion = 1.0
	soundReverb.WetLevel = 10
	soundReverb.Parent = jumpSound

	jumpSound:Play()

	local oldGui = localPlayer:WaitForChild("PlayerGui"):FindFirstChild("JumpscareOverlay")
	if oldGui then oldGui:Destroy() end

	local jumpGui = Instance.new("ScreenGui")
	jumpGui.Name = "JumpscareOverlay"
	jumpGui.IgnoreGuiInset = true
	jumpGui.DisplayOrder = 999999
	jumpGui.Parent = localPlayer:WaitForChild("PlayerGui")

	local img = Instance.new("ImageLabel")
	img.Size = UDim2.new(1, 0, 1, 0)
	img.Position = UDim2.new(0, 0, 0, 0)
	img.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	img.Image = "rbxassetid://" .. tostring(imageId)
	img.ScaleType = Enum.ScaleType.Stretch
	img.Parent = jumpGui

	task.wait(duration or 9)
	if jumpGui then jumpGui:Destroy() end
	if jumpSound then jumpSound:Destroy() end
end

local function removePlayerCharacterModels()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then
			pcall(function()
				plr.Character:Destroy()
			end)
		end
	end
end

